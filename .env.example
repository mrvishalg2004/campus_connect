# Server Configuration
PORT=3000
BASE_URL=http://localhost:3000

# Database Configuration (MongoDB URI)
# Local Compass example: mongodb://localhost:27017/campusconnect
# Cloud Atlas example: mongodb+srv://<user>:<password>@cluster.mongodb.net/campusconnect?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/campusconnect

# Authentication (JWT Secret)
JWT_SECRET=your_jwt_secret_key_here

# Payment Gateway (Razorpay Test Keys)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Email Notification Service (SMTP / Gmail App Password)
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
